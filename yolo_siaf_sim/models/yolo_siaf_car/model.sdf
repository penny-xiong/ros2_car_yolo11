<?xml version="1.0"?>
<sdf version="1.6">
  <model name="yolo_siaf_car">
    <pose>0 0 0.24 0 0 0</pose>
    <link name="base_link">
      <inertial><mass>30</mass><inertia><ixx>1.6</ixx><iyy>3.2</iyy><izz>3.8</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="body_collision"><pose>0 0 0.08 0 0 0</pose><geometry><box><size>1.10 0.70 0.28</size></box></geometry></collision>
      <visual name="body"><pose>0 0 0.08 0 0 0</pose><geometry><box><size>1.10 0.70 0.28</size></box></geometry><material><ambient>0.04 0.12 0.38 1</ambient><diffuse>0.06 0.20 0.65 1</diffuse></material></visual>
      <visual name="camera_housing"><pose>0.42 0 1.16 0 0 0</pose><geometry><box><size>0.10 0.20 0.11</size></box></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.06 0.06 0.06 1</diffuse></material></visual>
      <sensor name="rgb_camera" type="camera">
        <pose>0.48 0 1.16 0 0 0</pose><always_on>true</always_on><update_rate>20</update_rate>
        <camera><horizontal_fov>1.0471976</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.1</near><far>100</far></clip><noise><type>gaussian</type><mean>0</mean><stddev>0.008</stddev></noise></camera>
        <plugin name="rgb_camera_plugin" filename="libgazebo_ros_camera.so"><ros><namespace>/sensors/rgb</namespace></ros><camera_name>rgb</camera_name><frame_name>rgb_camera_link</frame_name></plugin>
      </sensor>
      <sensor name="ir_proxy_camera" type="camera">
        <pose>0.48 0 1.16 0 0 0</pose><always_on>true</always_on><update_rate>20</update_rate>
        <camera><horizontal_fov>1.0471976</horizontal_fov><image><width>640</width><height>480</height><format>L8</format></image><clip><near>0.1</near><far>100</far></clip><noise><type>gaussian</type><mean>0</mean><stddev>0.004</stddev></noise></camera>
        <plugin name="ir_camera_plugin" filename="libgazebo_ros_camera.so"><ros><namespace>/sensors/ir</namespace></ros><camera_name>ir</camera_name><frame_name>ir_camera_link</frame_name></plugin>
      </sensor>
    </link>

    <link name="left_wheel_link">
      <pose>0 0.36 -0.08 1.5708 0 0</pose><inertial><mass>1.2</mass><inertia><ixx>0.009</ixx><iyy>0.016</iyy><izz>0.009</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.16</radius><length>0.08</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><cylinder><radius>0.16</radius><length>0.08</length></cylinder></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
    </link>
    <link name="right_wheel_link">
      <pose>0 -0.36 -0.08 1.5708 0 0</pose><inertial><mass>1.2</mass><inertia><ixx>0.009</ixx><iyy>0.016</iyy><izz>0.009</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.16</radius><length>0.08</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><cylinder><radius>0.16</radius><length>0.08</length></cylinder></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
    </link>
    <joint name="left_wheel_joint" type="revolute"><parent>base_link</parent><child>left_wheel_link</child><axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper><effort>40</effort><velocity>30</velocity></limit></axis></joint>
    <joint name="right_wheel_joint" type="revolute"><parent>base_link</parent><child>right_wheel_link</child><axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper><effort>40</effort><velocity>30</velocity></limit></axis></joint>

    <link name="rear_caster_link">
      <pose>-0.43 0 -0.17 0 0 0</pose>
      <inertial><mass>0.2</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><geometry><sphere><radius>0.07</radius></sphere></geometry><surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><sphere><radius>0.07</radius></sphere></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
    </link>
    <joint name="rear_caster_joint" type="fixed"><parent>base_link</parent><child>rear_caster_link</child></joint>

    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros><namespace>/</namespace></ros><update_rate>50</update_rate>
      <left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.72</wheel_separation><wheel_diameter>0.32</wheel_diameter>
      <max_wheel_torque>40</max_wheel_torque><max_wheel_acceleration>4.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic><odometry_topic>odom</odometry_topic><odometry_frame>odom</odometry_frame><robot_base_frame>base_link</robot_base_frame>
      <publish_odom>true</publish_odom><publish_odom_tf>true</publish_odom_tf><publish_wheel_tf>true</publish_wheel_tf>
    </plugin>
  </model>
</sdf>
