<?xml version="1.0"?>
<sdf version="1.6">
  <model name="rgb_ir_camera_rig">
    <static>true</static>
    <link name="rig_link">
      <visual name="housing"><geometry><box><size>0.12 0.24 0.12</size></box></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
      <sensor name="rgb_camera" type="camera">
        <pose>0.07 0 0 0 0 0</pose><always_on>true</always_on><update_rate>20</update_rate>
        <camera><horizontal_fov>1.0471976</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.1</near><far>100</far></clip></camera>
        <plugin name="rgb_camera_plugin" filename="libgazebo_ros_camera.so"><ros><namespace>/sensors/rgb</namespace></ros><camera_name>rgb</camera_name><frame_name>rgb_camera_link</frame_name></plugin>
      </sensor>
      <sensor name="ir_proxy_camera" type="camera">
        <pose>0.07 0 0 0 0 0</pose><always_on>true</always_on><update_rate>20</update_rate>
        <camera><horizontal_fov>1.0471976</horizontal_fov><image><width>640</width><height>480</height><format>L8</format></image><clip><near>0.1</near><far>100</far></clip></camera>
        <plugin name="ir_camera_plugin" filename="libgazebo_ros_camera.so"><ros><namespace>/sensors/ir</namespace></ros><camera_name>ir</camera_name><frame_name>ir_camera_link</frame_name></plugin>
      </sensor>
    </link>
  </model>
</sdf>
