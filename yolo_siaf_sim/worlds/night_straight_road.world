<?xml version="1.0"?>
<sdf version="1.6">
  <world name="night_straight_road">
    <physics type="ode"><real_time_update_rate>1000</real_time_update_rate><max_step_size>0.001</max_step_size></physics>
    <scene><ambient>0.025 0.025 0.04 1</ambient><background>0.005 0.008 0.018 1</background><shadows>true</shadows></scene>
    <spherical_coordinates><surface_model>EARTH_WGS84</surface_model><world_frame_orientation>ENU</world_frame_orientation><latitude_deg>29.5</latitude_deg><longitude_deg>106.5</longitude_deg><elevation>0</elevation><heading_deg>0</heading_deg></spherical_coordinates>

    <light name="moon" type="directional">
      <pose>0 0 20 0 0 0</pose><diffuse>0.12 0.14 0.20 1</diffuse><specular>0.02 0.02 0.03 1</specular>
      <attenuation><range>200</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.4 0.1 -0.9</direction><cast_shadows>true</cast_shadows>
    </light>

    <include><uri>model://night_road</uri><name>night_road</name><pose>45 0 0 0 0 0</pose></include>
    <include><uri>model://street_lamp</uri><name>lamp_near_left</name><pose>20 5.0 0 0 0 0</pose></include>
    <include><uri>model://street_lamp</uri><name>lamp_middle_right</name><pose>35 -5.0 0 0 0 3.14159</pose></include>
    <include><uri>model://street_lamp</uri><name>lamp_far_left</name><pose>50 5.0 0 0 0 0</pose></include>

    <!-- Local actor asset. No online model database is required. -->
    <actor name="pedestrian_near">
      <pose>20 4.2 0 0 0 -1.5708</pose>
      <skin><filename>model://pedestrian_actor/meshes/walk.dae</filename><scale>1.0</scale></skin>
      <animation name="walking"><filename>model://pedestrian_actor/meshes/walk.dae</filename><scale>1.0</scale><interpolate_x>true</interpolate_x></animation>
      <script><loop>true</loop><delay_start>3.0</delay_start><auto_start>true</auto_start>
        <trajectory id="0" type="walking"><waypoint><time>0</time><pose>20 4.2 0 0 0 -1.5708</pose></waypoint><waypoint><time>10</time><pose>20 -4.2 0 0 0 -1.5708</pose></waypoint></trajectory>
      </script>
    </actor>

    <actor name="pedestrian_far">
      <pose>50 -4.2 0 0 0 1.5708</pose>
      <skin><filename>model://pedestrian_actor/meshes/walk.dae</filename><scale>1.0</scale></skin>
      <animation name="walking"><filename>model://pedestrian_actor/meshes/walk.dae</filename><scale>1.0</scale><interpolate_x>true</interpolate_x></animation>
      <script><loop>true</loop><delay_start>9.0</delay_start><auto_start>true</auto_start>
        <trajectory id="0" type="walking"><waypoint><time>0</time><pose>50 -4.2 0 0 0 1.5708</pose></waypoint><waypoint><time>13</time><pose>50 4.2 0 0 0 1.5708</pose></waypoint></trajectory>
      </script>
    </actor>
  </world>
</sdf>
